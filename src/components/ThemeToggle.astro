---
// Toggles light/dark, persisting the choice to localStorage.
// A single disc: filled = light, hollow = dark.
import { asLocale, t } from "../i18n/ui";

const tf = t(asLocale(Astro.currentLocale));
---

<button
  id="theme-toggle"
  type="button"
  aria-label={tf("a11y.theme")}
  class="group -mr-1 flex h-8 w-8 items-center justify-center"
>
  <span
    class="block h-3 w-3 rounded-full bg-fg transition-colors duration-200 group-hover:bg-accent dark:bg-transparent dark:shadow-[inset_0_0_0_1.5px_var(--fg)] dark:group-hover:shadow-[inset_0_0_0_1.5px_var(--accent)]"
  ></span>
</button>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
